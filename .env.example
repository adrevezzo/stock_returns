# Flask Configuration
FLASK_KEY=your-secret-key-here
FLASK_ENV=development

# API Keys (OPTIONAL - Yahoo Finance is used by default and doesn't require API keys)
# Only needed if you want to use alternative data sources
ALPHA_STOCK_API_KEY=your-alpha-vantage-api-key
FINN_STOCK_API_KEY=your-finnhub-api-key
NEWS_KEY=your-news-api-key